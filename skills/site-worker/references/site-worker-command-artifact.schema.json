{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Site Worker Command Artifact",
  "type": "object",
  "required": [
    "task_id",
    "source_version_hash",
    "completed_at",
    "command",
    "exit_code"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "source_version_hash": {
      "type": "string",
      "minLength": 1
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exit_code": {
      "const": 0
    }
  },
  "additionalProperties": true
}
